{
  "name": "behtafood-ai-agent",
  "version": "0.1.0",
  "private": true,
  "description": "AI food-ordering agent for Behtafood: plain tool calling on Meta Muse Spark, human approval before any order, runnable against a mock API.",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --import tsx --test \"packages/*/test/*.test.ts\" \"apps/*/test/*.test.ts\"",
    "typecheck": "node node_modules/typescript/bin/tsc -p tsconfig.json",
    "demo": "node --import tsx apps/mock-api/src/cli.ts --demo",
    "chat": "node --import tsx apps/mock-api/src/cli.ts",
    "mock-api": "node --import tsx apps/mock-api/src/main.ts --agent-enabled"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.23.12",
    "typescript": "~5.9.2"
  }
}
